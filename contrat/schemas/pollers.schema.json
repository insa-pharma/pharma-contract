{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pollers.schema.json",
  "title": "Configuration du poller Modbus (pollers.toml, une fois converti en JSON)",
  "description": "Types, plages et motifs. Les règles de cohérence entre champs (unicité de id/slave/serial, temp_min_c < temp_max_c effectifs) ne s'expriment pas en JSON Schema : voir test_pollers.py, que le poller Rust doit reproduire.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "site",
    "mqtt",
    "bus",
    "defaults",
    "node"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]{2,16}$"
        }
      }
    },
    "mqtt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "bus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "baud",
        "parity",
        "timeout_ms",
        "retries"
      ],
      "properties": {
        "device": {
          "type": "string",
          "pattern": "^/dev/[A-Za-z0-9._-]+$"
        },
        "baud": {
          "enum": [
            1200,
            2400,
            4800,
            9600,
            19200,
            38400,
            57600,
            115200
          ]
        },
        "parity": {
          "enum": [
            "none",
            "even",
            "odd"
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 10,
          "maximum": 5000
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_s",
        "temp_min_c",
        "temp_max_c"
      ],
      "properties": {
        "period_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "temp_min_c": {
          "type": "number",
          "minimum": -50,
          "maximum": 100
        },
        "temp_max_c": {
          "type": "number",
          "minimum": -50,
          "maximum": 100
        }
      }
    },
    "node": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slave",
          "zone"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "slave": {
            "type": "integer",
            "minimum": 1,
            "maximum": 247
          },
          "zone": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "serial": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "period_s": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "temp_min_c": {
            "type": "number",
            "minimum": -50,
            "maximum": 100
          },
          "temp_max_c": {
            "type": "number",
            "minimum": -50,
            "maximum": 100
          },
          "pir": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          }
        }
      }
    }
  }
}
